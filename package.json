{
  "name": "signature-desk",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/offline.mjs",
    "desktop": "node scripts/desktop.mjs dev",
    "package": "node scripts/desktop.mjs build",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:browser": "node tests/browser.mjs",
    "test:webkit-caps": "swift tests/webkit-caps.swift",
    "test:native": "node scripts/desktop.mjs test",
    "check": "tsc --noEmit && npm test"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/cli": "^2",
    "playwright": "^1.56.0",
    "pngjs": "^7.0.0",
    "prettier": "3.10.1",
    "typescript": "^5.9.0",
    "vite": "^7"
  }
}
